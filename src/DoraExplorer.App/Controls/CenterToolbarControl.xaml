<UserControl x:Class="DoraExplorer.App.Controls.CenterToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DoraExplorer.App.Controls"
             xmlns:infra="clr-namespace:DoraExplorer.App.Infrastructure"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="88">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/CenterToolbarIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="controls:CenterToolbarButton">
                <Setter Property="IconForeground" Value="{DynamicResource CenterToolbarButtonIconForegroundBrush}" />
            </Style>

            <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource CenterToolbarForegroundBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <Style x:Key="CategorySeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="4,6" />
                <Setter Property="Background" Value="{DynamicResource BorderBrushColor}" />
                <Setter Property="Opacity" Value="0.8" />
            </Style>

            <Style x:Key="SortMenuRowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background"
                                            Value="{DynamicResource MenuHoverBackgroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource CenterToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="0"
                MinWidth="150"
                Padding="6,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="PASTA"
                               Style="{StaticResource CategoryHeaderStyle}"
                               Margin="0,2,0,4" />

                    <UniformGrid Columns="2" HorizontalAlignment="Center">
                        <controls:CenterToolbarButton x:Name="SearchButton"
                                                      Label="Localizar"
                                                      Hint="Localizar arquivos e pastas"
                                                      IconGlyph="{StaticResource GlyphSearch}"
                                                      OpensMenu="True"
                                                      MenuClick="SearchButton_MenuClick" />

                        <controls:CenterToolbarButton Label="Nova pasta"
                                                      Hint="Nova pasta (Ctrl+Shift+N)"
                                                      IconGlyph="{StaticResource GlyphNewFolder}"
                                                      Command="{Binding NewFolderCommand}" />

                        <controls:CenterToolbarButton x:Name="SortButton"
                                                      Label="Ordenar"
                                                      Hint="Ordenar os itens da pasta atual"
                                                      IconGlyph="{StaticResource GlyphSort}"
                                                      OpensMenu="True"
                                                      MenuClick="SortButton_MenuClick" />

                        <controls:CenterToolbarButton Label="Atualizar"
                                                      Hint="Atualizar a pasta (F5)"
                                                      IconGlyph="{StaticResource GlyphRefresh}"
                                                      Command="{Binding RefreshCommand}" />

                        <controls:CenterToolbarButton x:Name="DuplicatesButton"
                                                      Label="Duplicados"
                                                      Hint="Procurar arquivos duplicados na pasta aberta"
                                                      IconGlyph="{StaticResource GlyphDuplicates}"
                                                      OpensMenu="True"
                                                      MenuClick="DuplicatesButton_MenuClick">
                            <controls:CenterToolbarButton.ContextMenu>
                                <ContextMenu Opened="DuplicatesMenu_Opened"
                                             Closed="DuplicatesMenu_Closed"
                                             Placement="Right">
                                    <MenuItem Header="Padrão: nome e tamanho"
                                              ToolTip="Rápido: não lê o conteúdo dos arquivos"
                                              Tag="Standard"
                                              Click="DuplicatesMode_Click" />
                                    <MenuItem Header="Profundo: tamanho e hash"
                                              ToolTip="Certeiro: compara o conteúdo (SHA-256) dos arquivos de mesmo tamanho"
                                              Tag="Deep"
                                              Click="DuplicatesMode_Click" />
                                </ContextMenu>
                            </controls:CenterToolbarButton.ContextMenu>
                        </controls:CenterToolbarButton>
                    </UniformGrid>

                    <Border Style="{StaticResource CategorySeparatorStyle}" />

                    <TextBlock Text="ARQUIVOS"
                               Style="{StaticResource CategoryHeaderStyle}" />

                    <UniformGrid Columns="2" HorizontalAlignment="Center">
                        <controls:CenterToolbarButton Label="Copiar"
                                                      Hint="Copiar a seleção para a pasta aberta no outro painel"
                                                      IconGlyph="{StaticResource GlyphCopy}"
                                                      Command="{Binding CopyCommand}" />

                        <controls:CenterToolbarButton Label="Mover"
                                                      Hint="Mover a seleção para a pasta aberta no outro painel"
                                                      IconGlyph="{StaticResource GlyphMove}"
                                                      Command="{Binding MoveCommand}" />

                        <controls:CenterToolbarButton Label="Renomear"
                                                      Hint="Renomear o item selecionado (F2)"
                                                      IconGlyph="{StaticResource GlyphRename}"
                                                      Command="{Binding RenameCommand}" />

                        <controls:CenterToolbarButton Label="Excluir"
                                                      Hint="Excluir a seleção (Delete)"
                                                      IconGlyph="{StaticResource GlyphDelete}"
                                                      Command="{Binding DeleteCommand}" />

                        <controls:CenterToolbarButton x:Name="CompressButton"
                                                      Label="Compactar"
                                                      Hint="Compactar a seleção em .zip ou .tar.gz"
                                                      IconGlyph="{StaticResource GlyphCompress}"
                                                      OpensMenu="True"
                                                      MenuClick="CompressButton_MenuClick">
                            <controls:CenterToolbarButton.ContextMenu>
                                <ContextMenu Opened="CompressMenu_Opened"
                                             Closed="CompressMenu_Closed"
                                             Placement="Right">
                                    <MenuItem Header="Arquivo .zip"
                                              Tag="Zip"
                                              Click="CompressFormat_Click" />
                                    <MenuItem Header="Arquivo .tar.gz"
                                              Tag="TarGz"
                                              Click="CompressFormat_Click" />
                                </ContextMenu>
                            </controls:CenterToolbarButton.ContextMenu>
                        </controls:CenterToolbarButton>

                        <controls:CenterToolbarButton Label="Favorito"
                                                      Hint="Marcar ou desmarcar como favorito (Ctrl+D)"
                                                      IconGlyph="{StaticResource GlyphFavorite}"
                                                      Command="{Binding FavoriteCommand}" />
                    </UniformGrid>

                    <Border Style="{StaticResource CategorySeparatorStyle}" />

                    <TextBlock Text="REDE SERVER"
                               Style="{StaticResource CategoryHeaderStyle}" />

                    <UniformGrid Columns="2" HorizontalAlignment="Center">
                        <controls:CenterToolbarButton Label="FTP"
                                                      Hint="Servidor FTP: configurar, iniciar ou parar"
                                                      IconData="{x:Static infra:NetworkProtocolIcons.FtpMark}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsFtpServiceActive}"
                                                      Command="{Binding FtpCommand}" />

                        <controls:CenterToolbarButton Label="SFTP"
                                                      Hint="Servidor SFTP: configurar, iniciar ou parar"
                                                      IconData="{x:Static infra:NetworkProtocolIcons.SftpMark}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsSftpServiceActive}"
                                                      Command="{Binding SftpCommand}" />

                        <controls:CenterToolbarButton Label="SCP"
                                                      Hint="Servidor SCP: configurar, iniciar ou parar"
                                                      IconData="{x:Static infra:NetworkProtocolIcons.ScpMark}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsScpServiceActive}"
                                                      Command="{Binding ScpCommand}" />

                        <controls:CenterToolbarButton Label="TFTP"
                                                      Hint="Servidor TFTP: configurar, iniciar ou parar"
                                                      IconData="{x:Static infra:NetworkProtocolIcons.TftpMark}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsTftpServiceActive}"
                                                      Command="{Binding TftpCommand}" />

                        <controls:CenterToolbarButton Label="SMB"
                                                      Hint="Servidor SMB (compartilhamento do Windows): configurar, iniciar ou parar"
                                                      IconData="{x:Static infra:NetworkProtocolIcons.SmbMark}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsSmbServiceActive}"
                                                      Command="{Binding SmbCommand}" />

                        <controls:CenterToolbarButton Label="NFS"
                                                      Hint="Servidor NFS (compartilhamento do Linux): configurar, iniciar ou parar"
                                                      IconData="{x:Static infra:NetworkProtocolIcons.NfsMark}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsNfsServiceActive}"
                                                      Command="{Binding NfsCommand}" />
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Popup x:Name="SearchPopup"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border x:Name="SearchPopupBorder"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1"
                    Padding="8"
                    Width="460">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Localizar"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SearchRootPath}"
                                   ToolTip="{Binding SearchRootPath}"
                                   FontSize="11"
                                   Opacity="0.85"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchPatternBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ExplorerInputTextBoxStyle}"
                                     Padding="6,4"
                                     Margin="0,0,8,0"
                                     KeyDown="SearchPatternBox_KeyDown" />
                            <Button x:Name="SearchRunButton"
                                    Grid.Column="1"
                                    Content="Pesquisar"
                                    Style="{StaticResource DialogButtonStyle}"
                                    Width="80"
                                    IsEnabled="{Binding IsSearchEnabled}"
                                    Click="SearchRun_Click" />
                        </Grid>
                        <!-- As colunas se ajustam arrastando a borda do cabeçalho; a alça no canto de baixo aumenta o menu inteiro. -->
                        <ListView x:Name="SearchResultsList"
                                  ItemsSource="{Binding SearchResults}"
                                  Style="{StaticResource FileListViewStyle}"
                                  ItemContainerStyle="{StaticResource FileListViewItemStyle}"
                                  Height="240"
                                  MouseDoubleClick="SearchResultsList_MouseDoubleClick">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False"
                                          ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="Nome" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           ToolTip="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Caminho" Width="260">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FullPath}"
                                                           ToolTip="{Binding FullPath}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <DockPanel Margin="0,6,0,0"
                                   LastChildFill="True">
                            <Button x:Name="SearchNewWindowButton"
                                    DockPanel.Dock="Right"
                                    Content="Abrir em Janela"
                                    ToolTip="Abrir os resultados numa janela maior, com as colunas ajustáveis"
                                    Style="{StaticResource DialogButtonStyle}"
                                    Margin="8,0,16,0"
                                    Padding="10,3"
                                    Click="SearchNewWindow_Click" />
                            <TextBlock Text="{Binding SearchStatusText}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Opacity="0.85"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </StackPanel>

                    <Thumb x:Name="SearchResizeGrip"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Width="16"
                           Height="16"
                           Margin="0,0,-4,-4"
                           Cursor="SizeNWSE"
                           ToolTip="Arraste para aumentar o menu"
                           DragDelta="SearchResizeGrip_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <TextBlock Text="&#x25E2;"
                                               FontSize="12"
                                               Foreground="{DynamicResource CenterToolbarForegroundBrush}"
                                               Opacity="0.7"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="SortPopup"
               Placement="Right"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1"
                    Padding="2"
                    MinWidth="200">
                <StackPanel>
                    <CheckBox x:Name="FoldersFirstCheckBox"
                              Content="Pastas primeiro"
                              Margin="10,8,10,6"
                              IsChecked="True"
                              Checked="FoldersFirstCheckBox_Changed"
                              Unchecked="FoldersFirstCheckBox_Changed" />

                    <Separator Margin="8,2" />

                    <Button x:Name="SortNameButton"
                            Style="{StaticResource SortMenuRowButtonStyle}"
                            Tag="Name"
                            Click="SortFieldButton_Click">
                        <Grid Width="168">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nome"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NameSortArrow"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button x:Name="SortSizeButton"
                            Style="{StaticResource SortMenuRowButtonStyle}"
                            Tag="Size"
                            Click="SortFieldButton_Click">
                        <Grid Width="168">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tamanho"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SizeSortArrow"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button x:Name="SortDateButton"
                            Style="{StaticResource SortMenuRowButtonStyle}"
                            Tag="Date"
                            Click="SortFieldButton_Click">
                        <Grid Width="168">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Data"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DateSortArrow"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button x:Name="SortExtensionButton"
                            Style="{StaticResource SortMenuRowButtonStyle}"
                            Tag="Extension"
                            Click="SortFieldButton_Click">
                        <Grid Width="168">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Extensão"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ExtensionSortArrow"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
