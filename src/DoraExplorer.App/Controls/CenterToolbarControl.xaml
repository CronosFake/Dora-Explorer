<UserControl x:Class="DoraExplorer.App.Controls.CenterToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DoraExplorer.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="88">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/CenterToolbarIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="controls:CenterToolbarButton">
                <Setter Property="IconForeground" Value="{DynamicResource CenterToolbarButtonIconForegroundBrush}" />
            </Style>

            <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource CenterToolbarForegroundBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <Style x:Key="CategorySeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="4,6" />
                <Setter Property="Background" Value="{DynamicResource BorderBrushColor}" />
                <Setter Property="Opacity" Value="0.8" />
            </Style>

            <Style x:Key="SortMenuRowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background"
                                            Value="{DynamicResource MenuHoverBackgroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource CenterToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="0"
                MinWidth="150"
                Padding="6,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="PASTA"
                               Style="{StaticResource CategoryHeaderStyle}"
                               Margin="0,2,0,4" />

                    <UniformGrid Columns="2" HorizontalAlignment="Center">
                        <controls:CenterToolbarButton x:Name="SearchButton"
                                                      Label="Localizar"
                                                      Hint="Localizar arquivos e pastas"
                                                      IconGlyph="{StaticResource GlyphSearch}"
                                                      OpensMenu="True"
                                                      MenuClick="SearchButton_MenuClick" />

                        <controls:CenterToolbarButton Label="Nova pasta"
                                                      Hint="Nova pasta (Ctrl+Shift+N)"
                                                      IconGlyph="{StaticResource GlyphNewFolder}"
                                                      Command="{Binding NewFolderCommand}" />

                        <controls:CenterToolbarButton x:Name="SortButton"
                                                      Label="Ordenar"
                                                      Hint="Ordenar os itens da pasta atual"
                                                      IconGlyph="{StaticResource GlyphSort}"
                                                      OpensMenu="True"
                                                      MenuClick="SortButton_MenuClick" />

                        <controls:CenterToolbarButton Label="Atualizar"
                                                      Hint="Atualizar a pasta (F5)"
                                                      IconGlyph="{StaticResource GlyphRefresh}"
                                                      Command="{Binding RefreshCommand}" />
                    </UniformGrid>

                    <Border Style="{StaticResource CategorySeparatorStyle}" />

                    <TextBlock Text="ARQUIVOS"
                               Style="{StaticResource CategoryHeaderStyle}" />

                    <UniformGrid Columns="2" HorizontalAlignment="Center">
                        <controls:CenterToolbarButton Label="Copiar"
                                                      Hint="Copiar a seleção para a pasta aberta no outro painel"
                                                      IconGlyph="{StaticResource GlyphCopy}"
                                                      Command="{Binding CopyCommand}" />

                        <controls:CenterToolbarButton Label="Mover"
                                                      Hint="Mover a seleção para a pasta aberta no outro painel"
                                                      IconGlyph="{StaticResource GlyphMove}"
                                                      Command="{Binding MoveCommand}" />

                        <controls:CenterToolbarButton Label="Renomear"
                                                      Hint="Renomear o item selecionado (F2)"
                                                      IconGlyph="{StaticResource GlyphRename}"
                                                      Command="{Binding RenameCommand}" />

                        <controls:CenterToolbarButton Label="Excluir"
                                                      Hint="Excluir a seleção (Delete)"
                                                      IconGlyph="{StaticResource GlyphDelete}"
                                                      Command="{Binding DeleteCommand}" />

                        <controls:CenterToolbarButton x:Name="CompressButton"
                                                      Label="Compactar"
                                                      Hint="Compactar a seleção em .zip ou .tar.gz"
                                                      IconGlyph="{StaticResource GlyphCompress}"
                                                      OpensMenu="True"
                                                      MenuClick="CompressButton_MenuClick">
                            <controls:CenterToolbarButton.ContextMenu>
                                <ContextMenu Opened="CompressMenu_Opened"
                                             Closed="CompressMenu_Closed"
                                             Placement="Right">
                                    <MenuItem Header="Arquivo .zip"
                                              Tag="Zip"
                                              Click="CompressFormat_Click" />
                                    <MenuItem Header="Arquivo .tar.gz"
                                              Tag="TarGz"
                                              Click="CompressFormat_Click" />
                                </ContextMenu>
                            </controls:CenterToolbarButton.ContextMenu>
                        </controls:CenterToolbarButton>

                        <controls:CenterToolbarButton Label="Favorito"
                                                      Hint="Marcar ou desmarcar como favorito (Ctrl+D)"
                                                      IconGlyph="{StaticResource GlyphFavorite}"
                                                      Command="{Binding FavoriteCommand}" />
                    </UniformGrid>

                    <Border Style="{StaticResource CategorySeparatorStyle}" />

                    <TextBlock Text="REDE SERVER"
                               Style="{StaticResource CategoryHeaderStyle}" />

                    <UniformGrid Columns="2" HorizontalAlignment="Center">
                        <controls:CenterToolbarButton Label="FTP"
                                                      Hint="Servidor FTP: configurar, iniciar ou parar"
                                                      IconGlyph="{StaticResource GlyphFtp}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsFtpServiceActive}"
                                                      Command="{Binding FtpCommand}" />

                        <controls:CenterToolbarButton Label="SFTP"
                                                      Hint="Servidor SFTP: configurar, iniciar ou parar"
                                                      IconGlyph="{StaticResource GlyphSftp}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsSftpServiceActive}"
                                                      Command="{Binding SftpCommand}" />

                        <controls:CenterToolbarButton Label="SCP"
                                                      Hint="Servidor SCP: configurar, iniciar ou parar"
                                                      IconGlyph="{StaticResource GlyphScp}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsScpServiceActive}"
                                                      Command="{Binding ScpCommand}" />

                        <controls:CenterToolbarButton Label="TFTP"
                                                      Hint="Servidor TFTP: configurar, iniciar ou parar"
                                                      IconGlyph="{StaticResource GlyphTftp}"
                                                      ShowServiceStatus="True"
                                                      IsServiceActive="{Binding IsTftpServiceActive}"
                                                      Command="{Binding TftpCommand}" />
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Popup x:Name="SearchPopup"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1"
                    Padding="8"
                    MinWidth="320"
                    MaxHeight="420">
                <StackPanel>
                    <TextBlock Text="Localizar"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SearchRootPath}"
                               FontSize="11"
                               Opacity="0.85"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SearchPatternBox"
                                 Style="{StaticResource ExplorerInputTextBoxStyle}"
                                 Width="220"
                                 Padding="6,4"
                                 Margin="0,0,8,0"
                                 KeyDown="SearchPatternBox_KeyDown" />
                        <Button x:Name="SearchRunButton"
                                Content="Pesquisar"
                                Style="{StaticResource DialogButtonStyle}"
                                Width="80"
                                IsEnabled="{Binding IsSearchEnabled}"
                                Click="SearchRun_Click" />
                    </StackPanel>
                    <ListView x:Name="SearchResultsList"
                              ItemsSource="{Binding SearchResults}"
                              Style="{StaticResource FileListViewStyle}"
                              ItemContainerStyle="{StaticResource FileListViewItemStyle}"
                              Height="240"
                              MouseDoubleClick="SearchResultsList_MouseDoubleClick">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeaderStyle}">
                                <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="120" />
                                <GridViewColumn Header="Caminho" DisplayMemberBinding="{Binding FullPath}" Width="170" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Text="{Binding SearchStatusText}"
                               FontSize="11"
                               Opacity="0.85"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="SortPopup"
               Placement="Right"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1"
                    Padding="2"
                    MinWidth="200">
                <StackPanel>
                    <CheckBox x:Name="FoldersFirstCheckBox"
                              Content="Pastas primeiro"
                              Margin="10,8,10,6"
                              IsChecked="True"
                              Checked="FoldersFirstCheckBox_Changed"
                              Unchecked="FoldersFirstCheckBox_Changed" />

                    <Separator Margin="8,2" />

                    <Button x:Name="SortNameButton"
                            Style="{StaticResource SortMenuRowButtonStyle}"
                            Tag="Name"
                            Click="SortFieldButton_Click">
                        <Grid Width="168">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nome"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NameSortArrow"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button x:Name="SortSizeButton"
                            Style="{StaticResource SortMenuRowButtonStyle}"
                            Tag="Size"
                            Click="SortFieldButton_Click">
                        <Grid Width="168">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tamanho"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SizeSortArrow"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button x:Name="SortDateButton"
                            Style="{StaticResource SortMenuRowButtonStyle}"
                            Tag="Date"
                            Click="SortFieldButton_Click">
                        <Grid Width="168">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Data"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DateSortArrow"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button x:Name="SortExtensionButton"
                            Style="{StaticResource SortMenuRowButtonStyle}"
                            Tag="Extension"
                            Click="SortFieldButton_Click">
                        <Grid Width="168">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Extensão"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ExtensionSortArrow"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
