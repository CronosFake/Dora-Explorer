<UserControl x:Class="DoraExplorer.App.Controls.FilePaneControl"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:vm="clr-namespace:DoraExplorer.App.ViewModels"

             xmlns:controls="clr-namespace:DoraExplorer.App.Controls"

             mc:Ignorable="d"

             d:DesignHeight="450"

             d:DesignWidth="400">

    <UserControl.Resources>

        <HierarchicalDataTemplate DataType="{x:Type vm:NavigationTreeNodeViewModel}"

                                  ItemsSource="{Binding Children}">

            <Grid HorizontalAlignment="Stretch">

                <Border HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Margin="{x:Static controls:TreeViewHierarchy.MultiSelectHighlightMargin}"
                        IsHitTestVisible="False"
                        CornerRadius="3"
                        BorderThickness="1"
                        Panel.ZIndex="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsItemSelected}" Value="True" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource TreeItemSelectedMutedBackgroundBrush}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Grid Panel.ZIndex="1">

                <Grid.Style>

                    <Style TargetType="Grid">

                        <Setter Property="MinHeight" Value="28" />

                        <Setter Property="VerticalAlignment" Value="Stretch" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsSimpleNavigationRoot}" Value="True">

                                <Setter Property="MinHeight" Value="30" />

                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsNavigationRoot}" Value="True">

                                <Setter Property="Margin" Value="0,0,0,10" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </Grid.Style>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" MinHeight="28" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>



                <Border Grid.Row="0"

                        Grid.Column="0"

                        Grid.ColumnSpan="4"

                        MinHeight="30"

                        IsHitTestVisible="False"

                        Visibility="{Binding IsSimpleNavigationRoot, Converter={StaticResource BoolToVisibilityConverter}}" />



                <Grid Grid.Row="0" Grid.Column="0"
                      Width="16"
                      Height="16"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left">
                    <Image Source="{Binding IconSource}"
                           Width="16"
                           Height="16"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding ShowShellIcon, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{Binding IconGlyph}"
                               FontFamily="{StaticResource FluentIconFontFamily}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding ShowGlyphIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                        <Setter Property="Foreground" Value="#FFC83B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Ellipse Width="7"
                             Height="7"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,-1,-1"
                             Stroke="{DynamicResource PanelBackgroundBrush}"
                             StrokeThickness="1"
                             SnapsToDevicePixels="True">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Fill" Value="{Binding NetworkHealthDotBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowNetworkHealthStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>



                <Grid Grid.Row="0"

                      Grid.Column="1"

                      HorizontalAlignment="Stretch"

                      VerticalAlignment="Center"

                      Margin="0,0,8,0"

                      Visibility="{Binding IsSimpleNavigationRoot, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="{Binding Name}"

                               FontFamily="Segoe UI"

                               FontSize="13"

                               Foreground="{DynamicResource ForegroundBrush}"

                               TextTrimming="CharacterEllipsis"

                               HorizontalAlignment="Stretch"

                               VerticalAlignment="Center"

                               Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"

                             FontFamily="Segoe UI"

                             FontSize="13"

                             Padding="1,0"

                             BorderThickness="1"

                             BorderBrush="{DynamicResource TreeFocusBorderBrush}"

                             Background="{DynamicResource PanelBackgroundBrush}"

                             Foreground="{DynamicResource ForegroundBrush}"

                             VerticalAlignment="Center"

                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}"

                             Loaded="RenameTextBox_Loaded"

                             PreviewKeyDown="RenameTextBox_PreviewKeyDown"

                             KeyDown="RenameTextBox_KeyDown"

                             LostFocus="RenameTextBox_LostFocus" />

                </Grid>



                <Grid Grid.Row="0" Grid.Column="1"

                      HorizontalAlignment="Stretch"

                      VerticalAlignment="Center"

                      Margin="0,0,8,0"

                      Visibility="{Binding IsSimpleNavigationRoot, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">



                    <TextBlock Text="{Binding Name}"

                               FontFamily="Segoe UI"

                               FontSize="13"

                               Foreground="{DynamicResource ForegroundBrush}"

                               TextTrimming="CharacterEllipsis"

                               HorizontalAlignment="Stretch"

                               VerticalAlignment="Center"

                               Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"

                             FontFamily="Segoe UI"

                             FontSize="13"

                             Padding="1,0"

                             BorderThickness="1"

                             BorderBrush="{DynamicResource TreeFocusBorderBrush}"

                             Background="{DynamicResource PanelBackgroundBrush}"

                             Foreground="{DynamicResource ForegroundBrush}"

                             VerticalAlignment="Center"

                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}"

                             Loaded="RenameTextBox_Loaded"

                             PreviewKeyDown="RenameTextBox_PreviewKeyDown"

                             KeyDown="RenameTextBox_KeyDown"

                             LostFocus="RenameTextBox_LostFocus" />

                </Grid>



                <StackPanel Grid.Row="2"

                            Grid.Column="1"

                            Grid.ColumnSpan="3"

                            Orientation="Horizontal"

                            Margin="24,2,8,0"

                            >
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolAndToVisibilityConverter}">
                            <Binding Path="ShowDirectoryCountSummary" />
                            <Binding Path="DataContext.ShowComfortableRows"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <TextBlock Text="&#xE72E;"
                               FontFamily="{StaticResource FluentIconFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TreeItemMetaForegroundBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ListingDenied, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock.ToolTip>
                            <ToolTip Style="{StaticResource ExplorerToolTipStyle}"
                                     Content="Sem permissão para abrir esta pasta" />
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowDirectoryCounts, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE8B7;"

                               FontFamily="{StaticResource FluentIconFontFamily}"

                               FontSize="11"

                               Foreground="{DynamicResource TreeItemMetaForegroundBrush}"

                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding FolderCount}"

                               Style="{StaticResource TreeItemMetaTextStyle}"

                               Margin="4,0,0,0"

                               VerticalAlignment="Center" />

                    <TextBlock Text="&#xE8A5;"

                               FontFamily="{StaticResource FluentIconFontFamily}"

                               FontSize="11"

                               Foreground="{DynamicResource TreeItemMetaForegroundBrush}"

                               Margin="12,0,0,0"

                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding FileCount}"

                               Style="{StaticResource TreeItemMetaTextStyle}"

                               Margin="4,0,0,0"

                               VerticalAlignment="Center" />
                    </StackPanel>

                </StackPanel>



                <StackPanel Grid.Row="0"

                            Grid.Column="3"

                            MinWidth="{Binding DataContext.TrailingColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Orientation="Horizontal"

                            HorizontalAlignment="Right"

                            VerticalAlignment="Center">

                    <TextBlock Text="&#xE735;"
                               FontFamily="{StaticResource FluentIconFontFamily}"
                               FontSize="12"
                               Foreground="#FFC83B"
                               Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsMarkedFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Grid Width="20"

                          VerticalAlignment="Center"

                          HorizontalAlignment="Right">

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <MultiDataTrigger>

                                        <MultiDataTrigger.Conditions>

                                            <Condition Binding="{Binding ShowSelectionMark}" Value="True" />

                                            <Condition Binding="{Binding IsItemSelected}" Value="True" />

                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False" />

                                        </MultiDataTrigger.Conditions>

                                        <Setter Property="Visibility" Value="Visible" />

                                    </MultiDataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Grid.Style>

                        <Viewbox Width="14"

                                 Height="14"

                                 HorizontalAlignment="Right"

                                 VerticalAlignment="Center"

                                 Stretch="Uniform">

                            <Canvas Width="16" Height="16">

                                <Path Data="M3.5,8.5 L7,12 L12.5,4"

                                      Stroke="{DynamicResource TreeItemSelectedBorderBrush}"

                                      StrokeThickness="2.25"

                                      StrokeStartLineCap="Round"

                                      StrokeEndLineCap="Round"

                                      StrokeLineJoin="Round"

                                      Fill="Transparent" />

                            </Canvas>

                        </Viewbox>

                    </Grid>

                </StackPanel>



                                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding DataContext.CompactRows, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Tipo: contagens (pastas) ou aplicativo padrão (arquivos) -->
                    <Grid Width="{Binding DataContext.TypeColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          ClipToBounds="True">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding ShowDirectoryCountSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE72E;"
                               FontFamily="{StaticResource FluentIconFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TreeItemMetaForegroundBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ListingDenied, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock.ToolTip>
                            <ToolTip Style="{StaticResource ExplorerToolTipStyle}"
                                     Content="Sem permissão para abrir esta pasta" />
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowDirectoryCounts, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE8B7;"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TreeItemMetaForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FolderCount}"
                                       Style="{StaticResource TreeItemMetaTextStyle}"
                                       Margin="4,0,0,0" />
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TreeItemMetaForegroundBrush}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FileCount}"
                                       Style="{StaticResource TreeItemMetaTextStyle}"
                                       Margin="4,0,0,0" />
                    </StackPanel>
                        </StackPanel>

                        <Button Style="{StaticResource TreeItemDefaultAppButtonStyle}"
                                Focusable="False"
                                IsTabStop="False"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Click="DefaultAppButton_Click">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource BoolAndToVisibilityConverter}">
                                    <Binding Path="ShowDefaultAppButton" />
                                    <Binding Path="DataContext.ShowDefaultApplication"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                            </Button.Visibility>
                            <TextBlock Text="{Binding DefaultApplicationName, FallbackValue='Escolher aplicativo'}"
                                       Style="{StaticResource TreeItemMetaTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ExplorerToolTipStyle}"
                                         Content="Aplicativo Padrão" />
                            </Button.ToolTip>
                            <Button.ContextMenu>
                                <ContextMenu Opened="DefaultAppMenu_Opened"
                                             Placement="Top" />
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- Modificado -->
                    <Grid Width="{Binding DataContext.DateColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Margin="8,0,0,0"
                          ClipToBounds="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TreeItemFooterMetaStyle}"
                                       Visibility="{Binding DataContext.ShowFileModifiedDate, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource AdaptiveModifiedDateConverter}">
                                        <Binding Path="LastModified" />
                                        <Binding Path="DataContext.UseShortModifiedDate"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Margin="8,0,0,0"
                                       Text="{Binding ModifiedTimeText}"
                                       Style="{StaticResource TreeItemFooterMetaStyle}"
                                       Visibility="{Binding DataContext.ShowFileModifiedTime, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Tamanho -->
                    <TextBlock Width="{Binding DataContext.SizeColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Margin="8,0,0,0"
                               Text="{Binding FileSizeText}"
                               Style="{StaticResource TreeItemFooterColumnStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ProgressBar Grid.Row="3"

                             Grid.Column="0"

                             Grid.ColumnSpan="4"

                             Height="4"

                             Margin="0,4,0,0"

                             Maximum="1"

                             Value="{Binding StorageUsedRatio}"

                             Background="{DynamicResource UsageTrackBrush}"
                             AutomationProperties.Name="Espaço usado"

                             BorderThickness="0"

                             HorizontalAlignment="Stretch"

                             Visibility="{Binding HasStorageInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="{DynamicResource UsageNormalBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StorageLevel}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource UsageWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StorageLevel}" Value="Critical">
                                    <Setter Property="Foreground" Value="{DynamicResource UsageCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>



                <TextBlock Grid.Row="4"

                           Grid.Column="0"

                           Grid.ColumnSpan="4"

                           Text="{Binding StorageSummary}"

                           MinWidth="208"

                           HorizontalAlignment="Right"

                           Margin="0,2,0,0"

                           TextTrimming="CharacterEllipsis"

                           Visibility="{Binding HasStorageInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- O texto acompanha o alerta: com destaque laranja ou vermelho, só a cor da barra
                         não distinguiria "atenção" e "crítico" do estado normal. -->
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TreeItemFooterColumnStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StorageLevel}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource UsageWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StorageLevel}" Value="Critical">
                                    <Setter Property="Foreground" Value="{DynamicResource UsageCriticalBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>



                <StackPanel Grid.Row="4"

                            Grid.Column="0"

                            Grid.ColumnSpan="4"

                            Orientation="Horizontal"

                            HorizontalAlignment="Right"

                            VerticalAlignment="Top"

                            Margin="0,2,0,0"

                            >
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource BoolAndToVisibilityConverter}">
                            <Binding Path="ShowFileMetadataFooter" />
                            <Binding Path="DataContext.ShowComfortableRows"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </StackPanel.Visibility>

                    <Button Style="{StaticResource TreeItemDefaultAppButtonStyle}"

                            Focusable="False"

                            IsTabStop="False"

                            VerticalAlignment="Center"

                            Click="DefaultAppButton_Click">

                        <Button.Visibility>

                            <MultiBinding Converter="{StaticResource BoolAndToVisibilityConverter}">

                                <Binding Path="ShowDefaultAppButton" />

                                <Binding Path="DataContext.ShowDefaultApplication"

                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />

                            </MultiBinding>

                        </Button.Visibility>

                        <TextBlock Text="{Binding DefaultApplicationName, FallbackValue='Escolher aplicativo'}"

                                   Style="{StaticResource TreeItemMetaTextStyle}"

                                   TextTrimming="CharacterEllipsis" />

                        <Button.ToolTip>

                            <ToolTip Style="{StaticResource ExplorerToolTipStyle}"

                                     Content="Aplicativo Padrão" />

                        </Button.ToolTip>

                        <Button.ContextMenu>

                            <ContextMenu Opened="DefaultAppMenu_Opened"

                                         Placement="Top" />

                        </Button.ContextMenu>

                    </Button>

                    <TextBlock Margin="8,0,0,0"

                               Style="{StaticResource TreeItemFooterMetaStyle}"

                               Visibility="{Binding DataContext.ShowFileModifiedDate, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock.Text>

                            <MultiBinding Converter="{StaticResource AdaptiveModifiedDateConverter}">

                                <Binding Path="LastModified" />

                                <Binding Path="DataContext.UseShortModifiedDate"

                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />

                            </MultiBinding>

                        </TextBlock.Text>

                    </TextBlock>

                    <TextBlock Margin="8,0,0,0"

                               Text="{Binding ModifiedTimeText}"

                               Style="{StaticResource TreeItemFooterMetaStyle}"

                               Visibility="{Binding DataContext.ShowFileModifiedTime, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Margin="8,0,0,0"

                               Text="{Binding FileSizeText}"

                               Style="{StaticResource TreeItemFooterMetaStyle}" />

                </StackPanel>

            </Grid>

            </Grid>

        </HierarchicalDataTemplate>

    </UserControl.Resources>



    <Border Background="{DynamicResource PanelBackgroundBrush}"

            BorderBrush="{DynamicResource BorderBrushColor}"

            BorderThickness="1"

            CornerRadius="0">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>



            <Border Grid.Row="0"

                    Background="{DynamicResource PathBarBackgroundBrush}"

                    BorderBrush="{DynamicResource BorderBrushColor}"

                    BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0">
                        <Button Style="{StaticResource PathNavButtonStyle}"
                                Command="{Binding GoBackCommand}"
                                ToolTip="Voltar (Alt+←)"
                                AutomationProperties.Name="Voltar">
                            <TextBlock Text="&#xE72B;"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource PathNavButtonStyle}"
                                Command="{Binding GoForwardCommand}"
                                ToolTip="Avançar (Alt+→)"
                                AutomationProperties.Name="Avançar">
                            <TextBlock Text="&#xE72A;"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource PathNavButtonStyle}"
                                Command="{Binding GoUpCommand}"
                                ToolTip="Subir uma pasta (Alt+↑)"
                                AutomationProperties.Name="Subir uma pasta">
                            <TextBlock Text="&#xE74A;"
                                       FontFamily="{StaticResource FluentIconFontFamily}"
                                       FontSize="13" />
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  Padding="6,4"
                                  VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding BreadcrumbSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BreadcrumbButtonStyle}"
                                            Content="{Binding Name}"
                                            Tag="{Binding IsFirst}"
                                            ToolTip="{Binding FullPath}"
                                            Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Column="2"
                            Style="{StaticResource PathCopyButtonStyle}"
                            ToolTip="Copiar caminho completo"
                            Command="{Binding CopySelectedPathCommand}">
                        <TextBlock Text="&#xE8C8;"
                                   FontFamily="{StaticResource FluentIconFontFamily}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Button>
                </Grid>

            </Border>




                        <Border x:Name="ColumnHeaderBar"
                    Grid.Row="1"
                    Background="{DynamicResource GridViewHeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding CompactRows, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid x:Name="ColumnHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource ColumnHeaderButtonStyle}"
                            Tag="Name"
                            Content="{Binding NameHeaderText}"
                            HorizontalContentAlignment="Left"
                            Padding="46,5,8,5"
                            ToolTip="Ordenar por nome"
                            Click="ColumnHeader_Click" />

                    <Button Grid.Column="1"
                            Style="{StaticResource ColumnHeaderButtonStyle}"
                            Tag="Extension"
                            Content="{Binding TypeHeaderText}"
                            Width="{Binding TypeColumnWidth}"
                            HorizontalContentAlignment="Left"
                            Padding="0,5"
                            ToolTip="Ordenar por tipo"
                            Click="ColumnHeader_Click" />

                    <Button Grid.Column="2"
                            Style="{StaticResource ColumnHeaderButtonStyle}"
                            Tag="Date"
                            Content="{Binding DateHeaderText}"
                            Width="{Binding DateColumnWidth}"
                            Margin="8,0,0,0"
                            HorizontalContentAlignment="Right"
                            Padding="0,5"
                            ToolTip="Ordenar por data de modificação"
                            Click="ColumnHeader_Click" />

                    <Button Grid.Column="3"
                            Style="{StaticResource ColumnHeaderButtonStyle}"
                            Tag="Size"
                            Content="{Binding SizeHeaderText}"
                            Width="{Binding SizeColumnWidth}"
                            Margin="8,0,0,0"
                            HorizontalContentAlignment="Right"
                            Padding="0,5"
                            ToolTip="Ordenar por tamanho"
                            Click="ColumnHeader_Click" />

                    <Border Grid.Column="4"
                            Width="{Binding TrailingColumnWidth}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" x:Name="TreeHost" ClipToBounds="True" AllowDrop="True">

            <TreeView x:Name="NavigationTree"

                      Style="{StaticResource NavigationTreeStyle}"

                      ItemsSource="{Binding NavigationRoots}"

                      ItemContainerStyle="{StaticResource NavigationTreeItemStyle}"

                      TreeViewItem.Expanded="NavigationTreeItem_Expanded"

                      TreeViewItem.Collapsed="NavigationTreeItem_Collapsed"

                      TreeViewItem.PreviewMouseLeftButtonDown="NavigationTreeItem_PreviewMouseLeftButtonDown"

                      SelectedItemChanged="NavigationTree_SelectedItemChanged" />

            <Canvas x:Name="MarqueeCanvas"

                    Panel.ZIndex="1"

                    ClipToBounds="True"

                    IsHitTestVisible="False"

                    Visibility="Collapsed" />

            </Grid>



            <Border Grid.Row="3"

                    BorderBrush="{DynamicResource BorderBrushColor}"

                    BorderThickness="0,1,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="DisplayMenuButton"

                        Style="{StaticResource DisplayMenuButtonStyle}"

                        Click="DisplayMenuButton_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#xE713;"

                                   FontFamily="{StaticResource FluentIconFontFamily}"

                                   FontSize="14"

                                   VerticalAlignment="Center" />

                        <TextBlock Text="Exibir"

                                   Margin="8,0,0,0"

                                   VerticalAlignment="Center" />

                    </StackPanel>

                    <Button.ContextMenu>

                        <ContextMenu Opened="DisplayMenu_Opened"

                                     Closed="DisplayMenu_Closed"

                                     Placement="Top">

                            <MenuItem Header="Favoritos"

                                      IsCheckable="True"

                                      StaysOpenOnClick="True"

                                      IsChecked="{Binding DisplayMenu.ShowFavorites, Mode=TwoWay}" />

                            <MenuItem Header="Lixeira"

                                      IsCheckable="True"

                                      StaysOpenOnClick="True"

                                      IsChecked="{Binding DisplayMenu.ShowRecycleBin, Mode=TwoWay}" />

                            <MenuItem Header="FTP"

                                      IsCheckable="True"

                                      StaysOpenOnClick="True"

                                      IsChecked="{Binding DisplayMenu.ShowFtp, Mode=TwoWay}" />

                            <MenuItem Header="SFTP"

                                      IsCheckable="True"

                                      StaysOpenOnClick="True"

                                      IsChecked="{Binding DisplayMenu.ShowSftp, Mode=TwoWay}" />

                            <MenuItem Header="SCP"

                                      IsCheckable="True"

                                      StaysOpenOnClick="True"

                                      IsChecked="{Binding DisplayMenu.ShowScp, Mode=TwoWay}" />

                            <MenuItem Header="TFTP"

                                      IsCheckable="True"

                                      StaysOpenOnClick="True"

                                      IsChecked="{Binding DisplayMenu.ShowTftp, Mode=TwoWay}" />

                        </ContextMenu>

                    </Button.ContextMenu>

                </Button>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               ToolTip="{Binding StatusText}"
                               Style="{StaticResource TreeItemFooterColumnStyle}"
                               FontSize="11"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

