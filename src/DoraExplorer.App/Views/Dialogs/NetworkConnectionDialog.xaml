<Window x:Class="DoraExplorer.App.Views.Dialogs.NetworkConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        MinWidth="480"
        MinHeight="360"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" MinHeight="260" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Configuração">
                <Grid Margin="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Endereço" VerticalAlignment="Center" />
                            <ComboBox x:Name="HostComboBox"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="0,0,0,6"
                                      Padding="4,2"
                                      IsEditable="False"
                                      IsTextSearchEnabled="True"
                                      DisplayMemberPath="DisplayText" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Porta" VerticalAlignment="Center" />
                            <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Padding="4,2" />

                            <TextBlock x:Name="UsernameLabel" Grid.Row="2" Grid.Column="0" Text="Utilizador" VerticalAlignment="Center" />
                            <TextBox x:Name="UsernameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Padding="4,2" />

                            <TextBlock x:Name="PasswordLabel" Grid.Row="3" Grid.Column="0" Text="Palavra-passe" VerticalAlignment="Center" />
                            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Padding="4,2" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Pasta raiz" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="4" Grid.Column="1" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Width="28"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        ToolTip="Selecionar pasta"
                                        Style="{StaticResource DialogButtonStyle}"
                                        Click="BrowseRoot_Click">
                                    <TextBlock FontFamily="{DynamicResource FluentIconFontFamily}"
                                               FontSize="14"
                                               Text="&#xE8B7;"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Button>
                                <TextBox x:Name="RootPathTextBox" Padding="4,2" VerticalContentAlignment="Center" />
                            </DockPanel>

                            <TextBlock x:Name="SecurityLabel" Grid.Row="5" Grid.Column="0" Text="Criptografia" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <ComboBox x:Name="SecurityComboBox"
                                      Grid.Row="5"
                                      Grid.Column="1"
                                      Margin="0,6,0,0"
                                      Padding="4,2"
                                      ToolTip="FTPS protege usuário, senha e arquivos na rede. O certificado é criado automaticamente.">
                                <ComboBoxItem Content="Opcional (aceita FTPS e FTP simples)" Tag="Optional" />
                                <ComboBoxItem Content="Obrigatória (somente FTPS)" Tag="Required" />
                                <ComboBoxItem Content="Desativada (FTP simples, não recomendado)" Tag="Disabled" />
                            </ComboBox>

                            <TextBlock x:Name="PassiveLabel" Grid.Row="6" Grid.Column="0" Text="Portas passivas" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBox x:Name="PassivePortsTextBox"
                                     Grid.Row="6"
                                     Grid.Column="1"
                                     Margin="0,6,0,0"
                                     Padding="4,2"
                                     ToolTip="Faixa das conexões de dados, por exemplo 50000-50100. Libere-a no firewall. Vazio = automática." />

                            <CheckBox x:Name="ReadOnlyCheckBox"
                                      Grid.Row="7"
                                      Grid.Column="1"
                                      Margin="0,8,0,0"
                                      Content="Somente leitura (não permite enviar, apagar nem renomear)" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Logs">
                <Grid Margin="8">
                    <TextBox x:Name="LogsTextBox"
                             Style="{StaticResource DialogLogTextBoxStyle}" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="PrimaryButton"
                    Content="Iniciar"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Style="{StaticResource DialogAccentButtonStyle}"
                    Click="Primary_Click" />
            <Button Content="Fechar"
                    Width="90"
                    IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
