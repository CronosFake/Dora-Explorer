<Window x:Class="DoraExplorer.App.Views.Dialogs.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Localizar"
        Height="480"
        Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Pesquisar em:"
                   Margin="0,0,0,4" />
        <TextBlock x:Name="RootPathText"
                   Grid.Row="1"
                   FontSize="11"
                   Opacity="0.85"
                   Margin="0,0,0,10"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <TextBox x:Name="PatternTextBox"
                     Width="360"
                     Padding="6,4"
                     Margin="0,0,8,0" />
            <CheckBox x:Name="RecursiveCheckBox"
                      Content="Incluir subpastas"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0" />
            <Button Content="Pesquisar"
                    Width="100"
                    Click="Search_Click" />
        </StackPanel>

        <ListView x:Name="ResultsList"
                  Grid.Row="3"
                  MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="220" />
                    <GridViewColumn Header="Caminho" DisplayMemberBinding="{Binding FullPath}" Width="340" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="4"
                   Margin="0,8,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
            <Button Content="Fechar"
                    DockPanel.Dock="Right"
                    Width="90"
                    HorizontalAlignment="Right"
                    Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
