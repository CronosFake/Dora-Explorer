<Window x:Class="DoraExplorer.App.Views.Dialogs.TransferProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transferência"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />
        <TextBlock x:Name="FileText"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TreeItemMetaForegroundBrush}"
                   Margin="0,0,0,8" />
        <ProgressBar x:Name="Bar"
                     Height="8"
                     Minimum="0"
                     Maximum="1"
                     IsIndeterminate="True"
                     BorderThickness="0"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource UsageTrackBrush}"
                     AutomationProperties.Name="Progresso da operação" />
        <TextBlock x:Name="DetailText"
                   Text="Calculando…"
                   Foreground="{DynamicResource TreeItemMetaForegroundBrush}"
                   Margin="0,8,0,16" />
        <Button x:Name="CancelButton"
                Content="Cancelar"
                Width="90"
                HorizontalAlignment="Right"
                IsCancel="True"
                Style="{StaticResource DialogButtonStyle}"
                Click="Cancel_Click" />
    </StackPanel>
</Window>
