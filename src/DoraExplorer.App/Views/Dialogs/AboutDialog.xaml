<Window x:Class="DoraExplorer.App.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre o Dora Explorer"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MinWidth="380"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <TextBlock Text="Dora Explorer"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="VersionText"
                               Opacity="0.85" />
                </StackPanel>
                <Image Grid.Column="1"
                       Source="pack://application:,,,/Assets/app-icon.png"
                       Width="72"
                       Height="72"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Gerenciador de ficheiros Windows com dois painéis,"
                       TextWrapping="Wrap"
                       Margin="0,0,0,2" />
            <TextBlock Text="navegação em árvore e suporte a FTP, SFTP, SCP e TFTP."
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />
            <TextBlock Margin="0,0,0,2">
                <Run Text="Desenvolvedor:" FontWeight="SemiBold" />
                <Run Text=" Vinicius Neves" />
            </TextBlock>
            <TextBlock Margin="0,0,0,20"
                       Opacity="0.85"
                       Text=".NET 8 / WPF" />
            <Button Content="OK"
                    Width="90"
                    HorizontalAlignment="Right"
                    Style="{StaticResource DialogAccentButtonStyle}"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
