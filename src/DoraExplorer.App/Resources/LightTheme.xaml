<!--
  Referência das cores do tema claro (Windows 11 Explorer / Fluent).
  Aplicadas em runtime por ExplorerThemeResources.cs
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="BorderColor">#FFE5E5E5</Color>
    <Color x:Key="MenuBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="MenuForegroundColor">#FF1A1A1A</Color>
    <Color x:Key="MenuHoverBackgroundColor">#FFE5E5E5</Color>
    <Color x:Key="PathBarBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CenterToolbarBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="CenterToolbarButtonBackgroundColor">#00000000</Color>
    <Color x:Key="CenterToolbarButtonIconForegroundColor">#FF1A1A1A</Color>
    <Color x:Key="ForegroundColor">#FF1A1A1A</Color>
    <Color x:Key="ListItemHoverBackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="ButtonHoverBackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="GridViewHeaderBackgroundColor">#FFF9F9F9</Color>
    <Color x:Key="GridViewHeaderForegroundColor">#FF1A1A1A</Color>

</ResourceDictionary>
