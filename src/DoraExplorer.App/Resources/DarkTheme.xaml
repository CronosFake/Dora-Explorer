<!--
  Referência das cores do tema escuro (Windows 11 Explorer / Fluent).
  Aplicadas em runtime por ExplorerThemeResources.cs
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#FF202020</Color>
    <Color x:Key="PanelBackgroundColor">#FF202020</Color>
    <Color x:Key="BorderColor">#FF3B3B3B</Color>
    <Color x:Key="MenuBackgroundColor">#FF202020</Color>
    <Color x:Key="MenuForegroundColor">#FFE8E8E8</Color>
    <Color x:Key="MenuHoverBackgroundColor">#FF3A3A3A</Color>
    <Color x:Key="PathBarBackgroundColor">#FF1C1C1C</Color>
    <Color x:Key="CenterToolbarBackgroundColor">#FF202020</Color>
    <Color x:Key="CenterToolbarButtonBackgroundColor">#00000000</Color>
    <Color x:Key="CenterToolbarButtonIconForegroundColor">#FFE8E8E8</Color>
    <Color x:Key="ForegroundColor">#FFE8E8E8</Color>
    <Color x:Key="ListItemHoverBackgroundColor">#FF3A3A3A</Color>
    <Color x:Key="ButtonHoverBackgroundColor">#FF3A3A3A</Color>
    <Color x:Key="GridViewHeaderBackgroundColor">#FF2D2D2D</Color>
    <Color x:Key="GridViewHeaderForegroundColor">#FFE8E8E8</Color>

</ResourceDictionary>
